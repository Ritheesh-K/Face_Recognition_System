# Face Recognition Identification System — Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.

# Application Information
PROJECT_NAME="Face Recognition Identification System"
API_V1_STR="/api"

# Database Configuration (SQLite Local Embedded DB)
DATABASE_URL="sqlite:///backend/data/face_recognition.db"

# InsightFace Biometric Model Configuration
MODEL_PACK="buffalo_sc"
DETECTION_THRESHOLD=0.50
DEFAULT_MATCHING_THRESHOLD=0.50
SIMILARITY_METRIC="cosine"

# Security & Privacy Controls
# Max file upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Biometric Image Retention Policy
# Number of days to retain query probe images before cleanup (0 = do not retain)
IMAGE_RETENTION_DAYS=30

# Whether to save query probe thumbnails for auditing
SAVE_RECOGNITION_PROBES=true

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# API Rate Limiting (max requests per minute per IP)
RATE_LIMIT_PER_MINUTE=120

# Biometric Privacy Notice:
# Face embeddings are biometric information and should be handled with care.
# This system operates 100% locally and offline. No biometric vectors or images
# are transmitted to external cloud providers.
